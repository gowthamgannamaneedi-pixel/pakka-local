# Local development. Copy to backend/.env
NODE_ENV=development
PORT=8080
JWT_SECRET=change-me-to-a-random-string-of-32-or-more-characters
ALLOWED_ORIGINS=http://localhost:3000
DB_PATH=./data/pakka-local.sqlite
OTP_PROVIDER=whatsapp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_API_VERSION=v21.0
# Web Push (generate with: cd backend && npm run vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
PUBLIC_API_URL=
# PILOT TESTING ONLY: log in as customer without WhatsApp. Only the listed numbers work, with the fixed code. Remove before launch.
# OTP_PROVIDER=testcode
# TEST_OTP_CODE=123456
# TEST_OTP_PHONES=+919876543210,+919812345678
# ALLOW_TEST_OTP=1   (required when NODE_ENV=production)

# Priority 2: map tiles for live tracking (Leaflet). In production set a provider whose terms allow your use; public OSM tiles are for development only.
# Example format: https://tiles.example.com/styles/basic/{z}/{x}/{y}.png?key=YOUR_KEY
MAP_TILE_URL=
# Set MAP_TILE_URL=none to switch the map off (status text only). Empty = no map on production, public OSM tiles on development.
MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Payments. No real gateway is integrated yet.
#   disabled = ordering closed (production default)   sandbox = simulated payments, refused when APP_ENV=production
# APP_ENV: production | staging | development | test. A staging server with sandbox payments must list tester phones.
APP_ENV=
PAYMENT_PROVIDER=
SANDBOX_PAYMENT_PHONES=

# Distance-based delivery charges: road distance from a SELF-HOSTED OSRM routing engine (see docs/DISTANCE-PRICING.md).
# Leave empty until the engine runs; with distance pricing switched on and no engine, orders use the admin fallback charge
# (or are refused if no fallback is set). Never point this at the public OSRM demo server.
OSRM_URL=
OSRM_PROFILE=driving
OSRM_TIMEOUT_MS=3000
