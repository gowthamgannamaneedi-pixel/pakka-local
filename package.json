{
  "name": "pakka-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pakka Local: one Express app serving the API and the four portals (/user, /restaurant, /rider, /admin). Root package for hosts that build from the repository root (Hostinger web apps).",
  "main": "server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node server.js",
    "jobs": "node backend/scripts/run-jobs.js",
    "migrate": "node backend/scripts/migrate.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  }
}
