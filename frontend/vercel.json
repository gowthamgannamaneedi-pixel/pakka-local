{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/user/:path*",
      "destination": "/user/index.html"
    },
    {
      "source": "/restaurant/:path*",
      "destination": "/restaurant/index.html"
    },
    {
      "source": "/rider/:path*",
      "destination": "/rider/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "outputDirectory": "public"
}